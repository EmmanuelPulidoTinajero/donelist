#!/bin/bash
# No `set -x` here: the trace would expand the secret payload and the database
# password into /var/log/cloud-init-output.log and the serial console, which
# defeats reading them from Secrets Manager. Progress is logged with echo lines.
set -euo pipefail

echo 'Installing packages'
dnf update -y
# Amazon Linux 2023 ships Node.js under versioned package names; fall back to
the plain package so either layout boots.
if ! dnf install -y git nodejs awscli postgresql15 python3 python3-pip; then
  echo 'Plain nodejs package unavailable, trying nodejs20'
  dnf install -y git nodejs20 awscli postgresql15 python3 python3-pip
fi
command -v npm >/dev/null || { echo 'npm is not on PATH after package install' >&2; exit 1; }

mkdir -p /opt/to-do-list-api
if [ -d /opt/to-do-list-api/.git ]; then
  git -C /opt/to-do-list-api fetch --tags origin
  git -C /opt/to-do-list-api checkout '${repository_branch}'
  git -C /opt/to-do-list-api pull --ff-only
else
  git clone --branch '${repository_branch}' '${repository_url}' /opt/to-do-list-api
fi

cd /opt/to-do-list-api
npm ci --omit=dev
echo 'Application dependencies installed'

# The schema bootstrap needs the credentials once; the service itself resolves
# them from Secrets Manager at runtime through DB_SECRET_ARN.
echo 'Reading the database credentials from Secrets Manager'
SECRET_JSON=$(aws secretsmanager get-secret-value --secret-id '${secret_arn}' --query SecretString --output text --region '${aws_region}')
DB_HOST=$(printf '%s' "$SECRET_JSON" | python3 -c 'import json,sys; print(json.load(sys.stdin)["host"])')
DB_PORT=$(printf '%s' "$SECRET_JSON" | python3 -c 'import json,sys; print(json.load(sys.stdin)["port"])')
DB_NAME=$(printf '%s' "$SECRET_JSON" | python3 -c 'import json,sys; print(json.load(sys.stdin)["database"])')
DB_USER=$(printf '%s' "$SECRET_JSON" | python3 -c 'import json,sys; print(json.load(sys.stdin)["username"])')
DB_PASSWORD=$(printf '%s' "$SECRET_JSON" | python3 -c 'import json,sys; print(json.load(sys.stdin)["password"])')

for attempt in $(seq 1 30); do
  echo "Applying db/schema.sql (attempt $attempt of 30)"
  if PGPASSWORD="$DB_PASSWORD" psql "host=$DB_HOST port=$DB_PORT dbname=$DB_NAME user=$DB_USER sslmode=require" -f db/schema.sql; then
    break
  fi
  if [ "$attempt" -eq 30 ]; then
    echo 'Database did not become ready in time' >&2
    exit 1
  fi
  sleep 10
done

mkdir -p /var/lib/to-do-list-api
touch /var/lib/to-do-list-api/metrics.json

cat > /etc/to-do-list-api.env <<EOF
DB_SECRET_ARN=${secret_arn}
DB_SSL=true
APP_VERSION=${app_version}
PORT=${app_port}
AWS_REGION=${aws_region}
METRICS_FILE=/var/lib/to-do-list-api/metrics.json
EOF
chmod 600 /etc/to-do-list-api.env

# boto3 publisher: the only component that calls put_metric_data.
python3 -m venv /opt/to-do-list-api-metrics
/opt/to-do-list-api-metrics/bin/pip install --quiet --upgrade pip boto3

cat > /etc/systemd/system/to-do-list-api.service <<'EOF'
[Unit]
Description=to-do-list-api
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/to-do-list-api
EnvironmentFile=/etc/to-do-list-api.env
ExecStart=/usr/bin/env npm start
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

cat > /etc/systemd/system/to-do-list-api-metrics.service <<'EOF'
[Unit]
Description=Publish to-do-list-api counters to CloudWatch
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ec2-user
EnvironmentFile=/etc/to-do-list-api.env
ExecStart=/opt/to-do-list-api-metrics/bin/python /opt/to-do-list-api/observability/publish_metrics.py
EOF

cat > /etc/systemd/system/to-do-list-api-metrics.timer <<'EOF'
[Unit]
Description=Publish to-do-list-api counters to CloudWatch every minute

[Timer]
OnBootSec=90
OnUnitActiveSec=60
AccuracySec=10s

[Install]
WantedBy=timers.target
EOF

chown -R ec2-user:ec2-user /opt/to-do-list-api /var/lib/to-do-list-api

systemctl daemon-reload
systemctl enable --now to-do-list-api
systemctl enable --now to-do-list-api-metrics.timer

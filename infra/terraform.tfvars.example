# Copy to terraform.tfvars (never committed) or export the TF_VAR_ equivalents.
aws_region            = "us-east-1"
repository_url        = "https://github.com/EmmanuelPulidoTinajero/donelist.git"
instance_profile_name = "LabInstanceProfile"
alert_email           = "your-email@example.com"

# The AMI is resolved by the aws_ami data source, so no ami_id is needed.
# Port 22 stays closed; uncomment this only for a one-off SSH session.
# ssh_cidr            = "YOUR.PUBLIC.IP/32"

# Only when the lab role needs an inline cloudwatch:PutMetricData grant. The
# Learner Lab role usually already allows it, so this stays empty.
# instance_role_name  = "LabRole"
